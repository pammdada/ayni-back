SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace-with-your-database-password
SUPABASE_JWT_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1
APP_SECURITY_JWT_ENABLED=true

# Opcional: ajuste del pool de conexiones
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
